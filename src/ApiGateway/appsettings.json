
{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "grievance-route": {
        "ClusterId": "grievance-cluster",
        "Match": {
          "Path": "/api/grievances/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:4101/"
          }
        }
      },
      "grievance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:4102/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
