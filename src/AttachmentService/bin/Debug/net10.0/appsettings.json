
{
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "GrievanceDb"
  },
  "Jwt": {
    "Issuer": "AiSmartGrievance.Auth",
    "Audience": "AiSmartGrievance.Client",
    "Secret": "LOCAL-DEV-ONLY-CHANGE-THIS-32-CHAR-MINIMUM"
  },
  "GrievanceService": {
    "BaseUrl": "http://localhost:4102/"
  },
  "FileStorage": {
    "UploadDirectory": "uploads",
    "MaxFileSizeBytes": 5242880
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
